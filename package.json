{
  "name": "web-docs-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for Kilo Code: free web search + library docs fetcher. Saves markdown to ./docs/ on demand.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "web-docs-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "clean": "rm -rf build .cache",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kilo-code",
    "cline",
    "roo-code",
    "claude-desktop",
    "web-search",
    "duckduckgo",
    "documentation"
  ],
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "author": ""
}
